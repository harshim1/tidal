# Ring Partner API (production) — or http://127.0.0.1:8787 for the ring-sandbox emulator
RING_BASE_URL=https://api.amazonvision.com
RING_ACCESS_TOKEN=
RING_HMAC_KEY=
RING_MEDIA_ORIGINS=*.amazonaws.com
TIDAL_DEVICES=                # comma-separated Ring device ids to watch (empty = all cameras)
TIDAL_PERSON_NAME=Dad
TIDAL_CLIP_MS=60000
TIDAL_CHECKIN_MINUTES=0       # e.g. 15 for live night check-ins (real cameras only)
TIDAL_NIGHT_START=21
TIDAL_NIGHT_END=8
TIDAL_RENDER=1
TIDAL_API_URL=http://127.0.0.1:8000
# Amazon Bedrock
TIDAL_BEDROCK=0
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Public hosting (TIDAL_PUBLIC=1 refuses to start without both secrets; the Docker image sets it)
TIDAL_PUBLIC=0
TIDAL_PASSWORD=               # dashboard + API, HTTP Basic auth (any username)
TIDAL_MCP_TOKEN=              # Alexa+/MCP clients send "Authorization: Bearer <token>" to /mcp
TIDAL_DEMO=0                  # 1 = serve the bundled synthetic night (demo/), no camera calls
TIDAL_UPLOADS=1
TIDAL_UPLOAD_MAX_S=180
